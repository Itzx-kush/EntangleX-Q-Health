APP_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./entanglex.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://(?:localhost|127\\.0\\.0\\.1|192\\.168\\.\\d{1,3}\\.\\d{1,3}|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3}):5173$
UPLOAD_DIR=./data/uploads
MODEL_DIR=./models
EXPERIMENT_DIR=./experiments
MAX_UPLOAD_SIZE_MB=25
DEFAULT_RANDOM_SEED=42
DEFAULT_QUBITS=4
MAX_QUBITS=8
